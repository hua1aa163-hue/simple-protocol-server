<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 发布版本使用用户指定的 v1.0.260817；程序集版本单独保持在 Windows 允许的范围内。 -->
    <Version>1.0.260817</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- 260817 超过 Windows 单段 65534 上限，因此拆成 26081.7。 -->
    <FileVersion>1.0.26081.7</FileVersion>
    <InformationalVersion>1.0.260817</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 第二屏跨不同 DPI 时仍使用实际设备像素，保证源图与屏幕严格 1:1。 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    显式告诉 Visual Studio：三个 .cs 文件是 WinForms 窗体，
    Designer.cs 和 resx 分别从属于对应窗体。
    这些信息放在正式项目文件中，换电脑或删除 .csproj.user 后仍然有效。
  -->
  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="ProjectionForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ProjectionForm.Designer.cs">
      <DependentUpon>ProjectionForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ProjectionForm.resx">
      <DependentUpon>ProjectionForm.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="SecondScreenProjectionForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="SecondScreenProjectionForm.Designer.cs">
      <DependentUpon>SecondScreenProjectionForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
