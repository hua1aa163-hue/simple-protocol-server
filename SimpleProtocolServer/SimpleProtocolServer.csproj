<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Git 标签使用用户指定的 v.1.0.260820；程序集数值版本不包含前缀字符。 -->
    <Version>1.0.260820</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- 260820 超过 Windows 单段 65534 上限，因此拆成 26082.0。 -->
    <FileVersion>1.0.26082.0</FileVersion>
    <InformationalVersion>v.1.0.260820</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 第二屏跨不同 DPI 时仍使用实际设备像素，保证源图与屏幕严格 1:1。 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    显式告诉 Visual Studio：四个 .cs 文件是 WinForms 窗体，
    Designer.cs 和 resx 分别从属于对应窗体。
    这些信息放在正式项目文件中，换电脑或删除 .csproj.user 后仍然有效。
  -->
  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="ProjectionForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ProjectionForm.Designer.cs">
      <DependentUpon>ProjectionForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ProjectionForm.resx">
      <DependentUpon>ProjectionForm.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="SecondScreenProjectionForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="SecondScreenProjectionForm.Designer.cs">
      <DependentUpon>SecondScreenProjectionForm.cs</DependentUpon>
    </Compile>

    <Compile Update="CrosstalkResultForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="CrosstalkResultForm.Designer.cs">
      <DependentUpon>CrosstalkResultForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="CrosstalkResultForm.resx">
      <DependentUpon>CrosstalkResultForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
